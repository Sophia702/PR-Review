GITHUB_TOKEN=ghp_your_personal_access_token
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pr_review
BACKFILL_DAYS=180
# Required to call POST /sync - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_KEY=
# Minutes between automatic re-syncs of every tracked repo. 0 disables it.
SYNC_INTERVAL_MINUTES=30

# GitHub OAuth App (github.com/settings/developers). Lets a logged-in user's
# own token be used for their sync requests instead of the shared GITHUB_TOKEN.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
# SameSite=None session cookies need HTTPS - false for local http:// dev, true in production
SESSION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
